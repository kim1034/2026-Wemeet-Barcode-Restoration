# 이 파일을 .env 로 복사해서 값을 채운다.
#
#     cp .env.example .env
#
# .env 는 .gitignore 에 있어서 커밋되지 않는다.
# 이 파일(.env.example)은 커밋되므로 여기에 실제 토큰을 쓰지 않는다.

# Hugging Face — 데이터셋과 모델 가중치를 받고 올린다. 전원 필요.
# 발급: huggingface.co → Settings → Access Tokens → New token (종류: Write)
# 자세히: docs/external/huggingface.md
HF_TOKEN=

# Weights & Biases — 학습 실험 기록. 학습을 돌리는 사람만 필요.
# 발급: wandb.ai → Settings → API keys
# 자세히: docs/external/wandb.md
WANDB_API_KEY=
